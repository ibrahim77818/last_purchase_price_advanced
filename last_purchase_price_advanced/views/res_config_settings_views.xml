<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_lpp" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.last.purchase.price.advanced</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="purchase.res_config_settings_view_form_purchase"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='purchase']" position="inside">
                <block title="Price Intelligence" name="lpp_setting_container" id="lpp_price_intelligence">
                    <setting id="lpp_tracking" company_dependent="1"
                             help="Show the last confirmed purchase price, its variance and a price signal on purchase order lines">
                        <field name="lpp_tracking_enabled"/>
                        <div class="content-group" invisible="not lpp_tracking_enabled">
                            <div class="row mt16">
                                <label for="lpp_lookup_scope" class="col-lg-6 o_light_label"/>
                                <field name="lpp_lookup_scope" class="col-lg-6" widget="radio" options="{'horizontal': true}"/>
                            </div>
                            <div class="row">
                                <label for="lpp_neutral_band" class="col-lg-6 o_light_label"/>
                                <div class="col-lg-6 d-flex align-items-baseline">
                                    <field name="lpp_neutral_band" style="max-width: 6rem;"/>
                                    <span class="ms-1">%</span>
                                </div>
                            </div>
                        </div>
                    </setting>
                    <setting id="lpp_stability_thresholds" string="Vendor Price Stability" company_dependent="1"
                             help="Coefficient of variation thresholds used to classify vendor prices as stable, moderate or volatile">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="lpp_stable_cv" class="col-lg-6 o_light_label"/>
                                <div class="col-lg-6 d-flex align-items-baseline">
                                    <field name="lpp_stable_cv" style="max-width: 6rem;"/>
                                    <span class="ms-1">%</span>
                                </div>
                            </div>
                            <div class="row">
                                <label for="lpp_volatile_cv" class="col-lg-6 o_light_label"/>
                                <div class="col-lg-6 d-flex align-items-baseline">
                                    <field name="lpp_volatile_cv" style="max-width: 6rem;"/>
                                    <span class="ms-1">%</span>
                                </div>
                            </div>
                        </div>
                        <div class="mt8">
                            <button name="%(last_purchase_price_advanced.action_lpp_vendor_price_report)d" type="action"
                                    string="Open Vendor Price Stability" icon="oi-arrow-right" class="btn-link"/>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
